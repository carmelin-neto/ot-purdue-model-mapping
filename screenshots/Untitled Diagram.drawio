        <mxCell id="xBIVQGcPLhyTpmCbq0CR-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2&gt;Level 3 Site Operations&lt;/h2&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Historians (database logging process data)&amp;nbsp;, MES ( Manufacturing Execution Systems) = This is where the OT data starts being useful for business reporting&lt;/font&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1020" y="895" as="geometry" />
        </mxCell>
        <mxCell id="xBIVQGcPLhyTpmCbq0CR-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2&gt;Level 2 Area Supervisory&lt;/h2&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;[HMI- Human-Machine Interface &amp;amp; SCADA systems ]&amp;nbsp;that let human operators monitor and control Level 1&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1020" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="xBIVQGcPLhyTpmCbq0CR-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2&gt;level 5 Enterprise IT&lt;/h2&gt;&lt;div&gt;Corporate enterprise systems (email, ERP, business intelligence).&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1020" y="-32" as="geometry" />
        </mxCell>
        <mxCell id="xBIVQGcPLhyTpmCbq0CR-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=20;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Level 3.5 Industrial DMZ&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Not part of the original Purdue Model, but modern, universally-adopted addition. It exists because Level 3 needs to communicate with Level 4/5, but we don&#39;t allow them to communicate directly — there&#39;s never a direct path from corporate IT into the control network. The DMZ is a buffer-zone.&lt;/font&gt;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1020" y="525" as="geometry" />
        </mxCell>
        <mxCell id="xBIVQGcPLhyTpmCbq0CR-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2&gt;Level 1 Basic Control&lt;/h2&gt;&lt;div&gt;[P&lt;font style=&quot;font-size: 14px;&quot;&gt;LC&#39;s/RTUs] It directly controls level 0 instruction base :&amp;nbsp;(open a valve when pressure exceeds X).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1020" x="-1" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="xBIVQGcPLhyTpmCbq0CR-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2&gt;Level 4 Site Business&lt;/h2&gt;&lt;div&gt;site-level business systems (local site reporting, site IT).&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1020" y="245" as="geometry" />
        </mxCell>
